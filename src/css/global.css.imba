global css a
	text-decoration-line:underline text-underline-offset:0.2em text-decoration-style:dashed
	text-decoration-color:yellow
	c:white @hover: yellow
	transition:color 0.2s ease
	cursor:pointer

global css button 
	w:100% h:12 ff:"mc7" bg:warm8/66% c:white bd:2px solid warm8 bdb:12px @hover: 6px mx:2 cursor:pointer

global css input
	h:6 w:96
	bg:warm8/66%
	bd:4px solid warm8
	c:white